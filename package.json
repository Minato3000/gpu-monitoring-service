{
  "name": "gpu-monitoring-service",
  "displayName": "GPU & CPU Monitor",
  "description": "Live NVIDIA GPU and CPU monitoring in your VS Code sidebar: per-core load, temperatures, RAM/VRAM, and the processes (and LLM models) behind them.",
  "version": "0.2.0",
  "publisher": "Minato3000",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Minato3000/gpu-monitoring-service"
  },
  "keywords": ["nvidia", "gpu", "cpu", "monitor", "sidebar", "vram", "nvidia-smi", "vllm", "sglang", "llm", "system monitor"],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "icon": "icons/gpu-monitor.png",
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gpu-monitoring-service-container",
          "title": "GPU & CPU Monitor",
          "icon": "icons/gpu-monitor.svg"
        }
      ]
    },
    "views": {
      "gpu-monitoring-service-container": [
        {
          "type": "webview",
          "id": "nvidiagpumonitor.panel",
          "name": "System Stats",
          "icon": "icons/gpu-monitor.svg",
          "contextualTitle": "GPU & CPU Monitor"
        }
      ]
    },
    "commands": [
      {
        "command": "nvidiagpumonitor.refresh",
        "title": "GPU & CPU Monitor: Refresh Now",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "nvidiagpumonitor.refresh",
          "when": "view == nvidiagpumonitor.panel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "GPU & CPU Monitor",
      "properties": {
        "nvidiagpumonitor.refreshInterval": {
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "maximum": 30000,
          "description": "Polling interval in milliseconds (default: 2000ms)"
        },
        "nvidiagpumonitor.appearanceFile": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to a JSON file that customizes the CPU core boxes (shape, size, corner radius, gap, and the color for each load level). Supports `~/` and paths relative to the workspace. Changes apply live. See `appearance.example.json`."
        },
        "nvidiagpumonitor.nvidiaSmiPath": {
          "type": "string",
          "default": "nvidia-smi",
          "description": "Path to the nvidia-smi executable"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.15.0"
  }
}
